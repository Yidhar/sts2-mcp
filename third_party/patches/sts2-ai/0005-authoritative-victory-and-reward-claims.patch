diff --git a/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSimulationOutcomeContract.cs b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSimulationOutcomeContract.cs
new file mode 100644
index 0000000000000000000000000000000000000000..957b073f8c0b0495812fb8227f6ed9a24d0fe0c1
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSimulationOutcomeContract.cs
@@ -0,0 +1,90 @@
+using System;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+/// <summary>
+/// Authoritative full-run terminal outcome rules. Presentation may report or
+/// render a victory, but it must never decide whether the simulator won.
+/// </summary>
+internal static class FullRunSimulationOutcomeContract
+{
+	internal const string Victory = "victory";
+	internal const string Defeat = "defeat";
+
+	internal static long NormalizeVictoryTime(long runTime)
+	{
+		// Pure simulation can finish within the same Unix-second tick in which it
+		// started. WinTime doubles as the upstream persisted victory latch, so zero
+		// must be promoted to a positive sentinel.
+		return Math.Max(1L, runTime);
+	}
+
+	internal static bool IsFinalBossVictory(
+		bool isBossRoom,
+		bool isFinalAct,
+		bool isSecondBossMapPoint,
+		bool isPrimaryBossMapPoint)
+	{
+		return isBossRoom
+			&& isFinalAct
+			&& (isSecondBossMapPoint || isPrimaryBossMapPoint);
+	}
+
+	internal static string? ResolveTerminalOutcome(bool isTerminal, long winTime)
+	{
+		if (!isTerminal)
+		{
+			return null;
+		}
+		return winTime > 0 ? Victory : Defeat;
+	}
+
+	internal static void RunSelfTests()
+	{
+		Assert(NormalizeVictoryTime(0L) == 1L, "zero-duration pure-sim victory must latch positively");
+		Assert(NormalizeVictoryTime(-5L) == 1L, "invalid negative run time must not erase victory");
+		Assert(NormalizeVictoryTime(17L) == 17L, "positive victory time must remain stable");
+		Assert(ResolveTerminalOutcome(isTerminal: false, winTime: 1L) == null,
+			"non-terminal snapshots must not publish an outcome");
+		Assert(ResolveTerminalOutcome(isTerminal: true, winTime: 0L) == Defeat,
+			"terminal snapshots without a victory latch must remain defeat");
+		Assert(ResolveTerminalOutcome(isTerminal: true, winTime: 1L) == Victory,
+			"terminal snapshots with a positive victory latch must be victory");
+		Assert(
+			IsFinalBossVictory(
+				isBossRoom: true,
+				isFinalAct: true,
+				isSecondBossMapPoint: false,
+				isPrimaryBossMapPoint: true),
+			"primary final boss must latch victory independently of presentation");
+		Assert(
+			IsFinalBossVictory(
+				isBossRoom: true,
+				isFinalAct: true,
+				isSecondBossMapPoint: true,
+				isPrimaryBossMapPoint: false),
+			"second final boss must latch victory independently of presentation");
+		Assert(
+			!IsFinalBossVictory(
+				isBossRoom: false,
+				isFinalAct: true,
+				isSecondBossMapPoint: false,
+				isPrimaryBossMapPoint: true),
+			"non-boss rooms must never latch final victory");
+		Assert(
+			!IsFinalBossVictory(
+				isBossRoom: true,
+				isFinalAct: false,
+				isSecondBossMapPoint: false,
+				isPrimaryBossMapPoint: true),
+			"earlier-act bosses must never latch final victory");
+	}
+
+	private static void Assert(bool condition, string detail)
+	{
+		if (!condition)
+		{
+			throw new InvalidOperationException($"Full-run outcome contract self-test failed: {detail}.");
+		}
+	}
+}
