+using System;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+/// <summary>
+/// Internal control-flow signal: the preceding action was committed, but the
+/// simulator exhausted its bounded settlement budget before observing a
+/// stable agent decision surface.
+/// </summary>
+public sealed class FullRunSettlementUnsettledException : InvalidOperationException
+{
+	public FullRunSimulationStateSnapshot Snapshot { get; }
+
+	public FullRunSettlementUnsettledException(
+		FullRunSimulationStateSnapshot snapshot,
+		string message)
+		: base(message)
+	{
+		Snapshot = snapshot ?? throw new ArgumentNullException(nameof(snapshot));
+	}
+}
