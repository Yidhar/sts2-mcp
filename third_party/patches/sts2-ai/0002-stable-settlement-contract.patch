diff --git a/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSettlementContract.cs b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSettlementContract.cs
new file mode 100644
index 0000000000000000000000000000000000000000..e34c48ca706239e3ee5a250ef6c490e4dac0982f
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunSettlementContract.cs
@@ -0,0 +1,265 @@
+using System;
+using System.Collections.Generic;
+using System.Threading;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+/// <summary>
+/// Stable-surface protocol shared by the runtime facade and every transport.
+/// A mutating step may be committed before its asynchronous game transition is
+/// settled, but a non-terminal snapshot with no legal actions is never a valid
+/// environment result.
+/// </summary>
+public static class FullRunSettlementContract
+{
+	public const string Actionable = "actionable";
+	public const string Terminal = "terminal";
+	public const string Pending = "pending";
+	public const string Unsettled = "unsettled";
+	public const string Rejected = "rejected";
+	public const string Invalid = "invalid";
+	public const string PostCombatRewards = "rewards";
+	public const string PostCombatProceedWithoutRewards = "proceed_without_rewards";
+
+	/// <summary>
+	/// Mirrors NCombatUi.OnCombatWon. Rewardless encounters must not construct a
+	/// RewardsSet because the native UI bypasses reward generation and every
+	/// reward hook for that branch.
+	/// </summary>
+	public static string ResolvePostCombatContinuation(bool shouldGiveRewards)
+	{
+		return shouldGiveRewards
+			? PostCombatRewards
+			: PostCombatProceedWithoutRewards;
+	}
+
+	public static string ClassifySnapshot(FullRunSimulationStateSnapshot snapshot)
+	{
+		ArgumentNullException.ThrowIfNull(snapshot);
+		int legalCount = snapshot.LegalActions?.Count ?? 0;
+		if (snapshot.IsTerminal)
+		{
+			return legalCount == 0 ? Terminal : Invalid;
+		}
+		if (legalCount > 0)
+		{
+			return Actionable;
+		}
+		return Pending;
+	}
+
+	public static bool IsStableSurface(FullRunSimulationStateSnapshot snapshot)
+	{
+		string status = ClassifySnapshot(snapshot);
+		return status == Actionable || status == Terminal;
+	}
+
+	/// <summary>
+	/// Deterministic contract/property tests runnable without bootstrapping game
+	/// assets.  Kept beside the production classifier so future state types
+	/// cannot silently reintroduce the old default-ready behavior.
+	/// </summary>
+	public static void RunSelfTests()
+	{
+		FullRunSimulationLegalAction action = new FullRunSimulationLegalAction
+		{
+			Action = "test",
+			IsSupported = true
+		};
+
+		AssertStatus(
+			new FullRunSimulationStateSnapshot { IsRunActive = true, StateType = "monster" },
+			Pending,
+			"map-to-combat intermediate frame must remain pending");
+		AssertStatus(
+			new FullRunSimulationStateSnapshot
+			{
+				IsRunActive = true,
+				StateType = "monster",
+				LegalActions = new List<FullRunSimulationLegalAction> { action }
+			},
+			Actionable,
+			"combat becomes actionable only after legal actions exist");
+		AssertStatus(
+			new FullRunSimulationStateSnapshot { IsTerminal = true, StateType = "game_over" },
+			Terminal,
+			"terminal zero-action state");
+		AssertStatus(
+			new FullRunSimulationStateSnapshot
+			{
+				IsTerminal = true,
+				StateType = "game_over",
+				LegalActions = new List<FullRunSimulationLegalAction> { action }
+			},
+			Invalid,
+			"terminal state must not expose legal actions");
+
+		if (ResolvePostCombatContinuation(shouldGiveRewards: true) != PostCombatRewards
+			|| ResolvePostCombatContinuation(shouldGiveRewards: false) != PostCombatProceedWithoutRewards)
+		{
+			throw new InvalidOperationException(
+				"Settlement contract self-test failed: rewardless combat must use the native proceed-without-rewards route."
+			);
+		}
+
+		// Reset/load invalidation and continuation registration share the same
+		// generation gate. Prove that a stale or cancelled continuation cannot
+		// register a choice after invalidation, while a fresh generation can.
+		FullRunContinuationGeneration generation = new FullRunContinuationGeneration();
+		using CancellationTokenSource staleCancellation = new CancellationTokenSource();
+		long stale = generation.Capture();
+		int registrations = 0;
+		if (!generation.TryRun(
+			stale,
+			staleCancellation.Token,
+			() => ++registrations,
+			out int firstRegistration)
+			|| firstRegistration != 1)
+		{
+			throw new InvalidOperationException(
+				"Settlement contract self-test failed: current continuation could not register."
+			);
+		}
+		generation.Invalidate(() => staleCancellation.Cancel());
+		if (generation.TryRun(
+			stale,
+			staleCancellation.Token,
+			() => ++registrations,
+			out _))
+		{
+			throw new InvalidOperationException(
+				"Settlement contract self-test failed: stale continuation registered after reset."
+			);
+		}
+		using CancellationTokenSource currentCancellation = new CancellationTokenSource();
+		long current = generation.Capture();
+		if (!generation.TryRun(
+			current,
+			currentCancellation.Token,
+			() => ++registrations,
+			out int secondRegistration)
+			|| secondRegistration != 2)
+		{
+			throw new InvalidOperationException(
+				"Settlement contract self-test failed: fresh continuation generation was rejected."
+			);
+		}
+
+		// Property sweep over representative current and future state names.  The
+		// classification is intentionally independent of state_type: no unknown
+		// state is allowed to inherit an implicit ready=true default.
+		string[] stateTypes =
+		{
+			"menu", "run_bootstrap", "map", "event", "rest_site", "shop",
+			"treasure", "monster", "elite", "boss", "hand_select",
+			"card_select", "combat_start_pending", "combat_post_end_pending",
+			"future_unknown_state"
+		};
+		foreach (string stateType in stateTypes)
+		{
+			foreach (bool runActive in new[] { false, true })
+			{
+				foreach (bool terminal in new[] { false, true })
+				{
+					foreach (int legalCount in new[] { 0, 1, 7 })
+					{
+						List<FullRunSimulationLegalAction> legal = new List<FullRunSimulationLegalAction>();
+						for (int i = 0; i < legalCount; i++)
+						{
+							legal.Add(action);
+						}
+						FullRunSimulationStateSnapshot snapshot = new FullRunSimulationStateSnapshot
+						{
+							IsRunActive = runActive,
+							IsTerminal = terminal,
+							StateType = stateType,
+							LegalActions = legal
+						};
+						string expected = terminal
+							? (legalCount == 0 ? Terminal : Invalid)
+							: (legalCount > 0 ? Actionable : Pending);
+						AssertStatus(snapshot, expected, $"property sweep {stateType}/{runActive}/{terminal}/{legalCount}");
+					}
+				}
+			}
+		}
+	}
+
+	private static void AssertStatus(
+		FullRunSimulationStateSnapshot snapshot,
+		string expected,
+		string context)
+	{
+		string actual = ClassifySnapshot(snapshot);
+		if (!string.Equals(actual, expected, StringComparison.Ordinal))
+		{
+			throw new InvalidOperationException(
+				$"Settlement contract self-test failed ({context}): expected={expected}, actual={actual}.");
+		}
+		bool expectedStable = expected == Actionable || expected == Terminal;
+		if (IsStableSurface(snapshot) != expectedStable)
+		{
+			throw new InvalidOperationException(
+				$"Settlement stability self-test failed ({context}): expected_stable={expectedStable}.");
+		}
+	}
+}
+
+/// <summary>
+/// Small synchronization primitive shared by post-combat continuation
+/// registration and reset/load invalidation. Actions passed to TryRun execute
+/// while the generation lock is held, making "check then register" atomic with
+/// Invalidate.
+/// </summary>
+internal sealed class FullRunContinuationGeneration
+{
+	private readonly object _gate = new object();
+
+	private long _generation;
+
+	public long Capture()
+	{
+		lock (_gate)
+		{
+			return _generation;
+		}
+	}
+
+	public long Invalidate(Action invalidateUnderLock)
+	{
+		ArgumentNullException.ThrowIfNull(invalidateUnderLock);
+		lock (_gate)
+		{
+			_generation = checked(_generation + 1L);
+			invalidateUnderLock();
+			return _generation;
+		}
+	}
+
+	public bool IsCurrent(long generation, CancellationToken cancellationToken)
+	{
+		lock (_gate)
+		{
+			return generation == _generation && !cancellationToken.IsCancellationRequested;
+		}
+	}
+
+	public bool TryRun<T>(
+		long generation,
+		CancellationToken cancellationToken,
+		Func<T> action,
+		out T result)
+	{
+		ArgumentNullException.ThrowIfNull(action);
+		lock (_gate)
+		{
+			if (generation != _generation || cancellationToken.IsCancellationRequested)
+			{
+				result = default!;
+				return false;
+			}
+			result = action();
+			return true;
+		}
+	}
+}
