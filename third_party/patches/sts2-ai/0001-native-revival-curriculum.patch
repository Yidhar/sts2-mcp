diff --git a/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalController.cs b/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalController.cs
new file mode 100644
index 0000000..6dacd8a
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalController.cs
@@ -0,0 +1,62 @@
+using System;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+/// <summary>
+/// Simulator-only accounting and budget control for native-revival preheat.
+/// A null budget disables the training override, -1 is unlimited, and any
+/// non-negative value is the total number of native Lizard Tail revivals that
+/// may fire in the current reset episode, including an entire full run.
+/// </summary>
+public static class TrainingRevivalController
+{
+	private static int? _revivalBudget;
+
+	public static bool IsEnabled => _revivalBudget.HasValue;
+
+	public static int? RevivalBudget => _revivalBudget;
+
+	public static int RevivalsUsed { get; private set; }
+
+	public static int PlayerHpLost { get; private set; }
+
+	public static bool CanRevive => IsEnabled
+		&& (_revivalBudget == -1 || RevivalsUsed < _revivalBudget);
+
+	public static void Configure(int? revivalBudget)
+	{
+		if (revivalBudget.HasValue && revivalBudget.Value < -1)
+		{
+			throw new InvalidOperationException(
+				"training_revival_budget must be null, -1, or a non-negative integer."
+			);
+		}
+
+		_revivalBudget = revivalBudget;
+		RevivalsUsed = 0;
+		PlayerHpLost = 0;
+	}
+
+	public static void RecordRevival()
+	{
+		if (!CanRevive)
+		{
+			throw new InvalidOperationException(
+				"A training revival fired after its configured budget was exhausted."
+			);
+		}
+
+		RevivalsUsed = checked(RevivalsUsed + 1);
+	}
+
+	public static void RecordHpLoss(Creature creature, int amount)
+	{
+		if (!IsEnabled || !creature.IsPlayer || amount <= 0)
+		{
+			return;
+		}
+
+		PlayerHpLost = checked(PlayerHpLost + amount);
+	}
+}
