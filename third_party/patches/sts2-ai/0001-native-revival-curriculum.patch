+	private static List<Dictionary<string, object?>> BuildCatalogDynamicVarsSafely(
+		Func<IEnumerable<CombatTrainingDynamicVarSnapshot>> valuesFactory)
+	{
+		try
+		{
+			return BuildCatalogDynamicVars(valuesFactory());
+		}
+		catch
+		{
+			return new List<Dictionary<string, object?>>();
+		}
+	}
+
+	private static T SafeCatalogValue<T>(Func<T> valueFactory, T fallback)
+	{
+		try
+		{
+			return valueFactory();
+		}
+		catch
+		{
+			return fallback;
+		}
+	}
+
