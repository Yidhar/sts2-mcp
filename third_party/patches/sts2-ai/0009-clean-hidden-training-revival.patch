diff --git a/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalSelfTests.cs b/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalSelfTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..89f581b501d1aea1d899bb881d4d998d2f7460dc
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/TrainingRevivalSelfTests.cs
@@ -0,0 +1,185 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json;
+using System.Threading.Tasks;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models.Relics;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+internal static class TrainingRevivalSelfTests
+{
+	private const string CharacterId = "IRONCLAD";
+
+	public static async Task RunAsync(FullRunTrainingEnvService service)
+	{
+		await OrdinaryLethalUsesHiddenBailoutAsync(service);
+		await ForceKillBypassesHiddenBailoutAsync(service);
+		await NonPositiveMaxHpBypassesHiddenBailoutAsync(service);
+		await NativeLizardTailPrecedesHiddenBailoutAsync(service);
+		await ResetAndSnapshotLifecycleIsRunScopedAsync(service);
+	}
+
+	private static async Task OrdinaryLethalUsesHiddenBailoutAsync(FullRunTrainingEnvService service)
+	{
+		FullRunSimulationStateSnapshot state = await ResetAsync(service, "CLEAN_REVIVAL_ORDINARY", budget: 1);
+		RunState runState = CurrentRun();
+		Player player = LocalPlayer(runState);
+		AssertNoInjectedRevivalEntity(runState, state);
+
+		int expectedHp = Math.Max(1, player.Creature.MaxHp / 2);
+		await CreatureCmd.Kill(player.Creature);
+		TrainingRevivalSnapshot training = TrainingRevivalController.Capture(runState);
+		Assert(!player.Creature.IsDead, "ordinary lethal damage must be recovered by the hidden bailout");
+		Assert(player.Creature.CurrentHp == expectedHp,
+			$"hidden bailout must heal 50% MaxHp (expected={expectedHp}, actual={player.Creature.CurrentHp})");
+		Assert(training.RevivalsUsed == 1, "ordinary lethal damage must consume exactly one hidden bailout");
+		Assert(training.PlayerHpLost > 0, "ordinary lethal damage must remain visible to HP-loss accounting");
+
+	}
+
+	private static async Task ForceKillBypassesHiddenBailoutAsync(FullRunTrainingEnvService service)
+	{
+		await ResetAsync(service, "CLEAN_REVIVAL_FORCE", budget: -1);
+		RunState runState = CurrentRun();
+		Player player = LocalPlayer(runState);
+		AttachMinimalCombat(runState, player);
+		await CreatureCmd.Kill(player.Creature, force: true);
+		Assert(player.Creature.IsDead, "force:true must remain an authoritative death");
+		Assert(TrainingRevivalController.Capture(runState).RevivalsUsed == 0,
+			"force:true must not consume or trigger the hidden bailout");
+	}
+
+	private static async Task NonPositiveMaxHpBypassesHiddenBailoutAsync(FullRunTrainingEnvService service)
+	{
+		await ResetAsync(service, "CLEAN_REVIVAL_MAX_HP", budget: -1);
+		RunState runState = CurrentRun();
+		Player player = LocalPlayer(runState);
+		AttachMinimalCombat(runState, player);
+		await CreatureCmd.SetMaxHp(player.Creature, 0m);
+		Assert(player.Creature.MaxHp == 0 && player.Creature.IsDead,
+			"MaxHp <= 0 must remain an authoritative death");
+		Assert(TrainingRevivalController.Capture(runState).RevivalsUsed == 0,
+			"MaxHp <= 0 must not consume or trigger the hidden bailout");
+	}
+
+	private static async Task NativeLizardTailPrecedesHiddenBailoutAsync(FullRunTrainingEnvService service)
+	{
+		await ResetAsync(
+			service,
+			"CLEAN_REVIVAL_NATIVE_FIRST",
+			budget: 1,
+			additionalRelics: new List<SimulationBuildRelicSpec>
+			{
+				new SimulationBuildRelicSpec { Id = "LIZARD_TAIL" }
+			});
+		RunState runState = CurrentRun();
+		Player player = LocalPlayer(runState);
+		LizardTail lizardTail = player.Relics.OfType<LizardTail>().Single();
+
+		await CreatureCmd.Kill(player.Creature);
+		Assert(!player.Creature.IsDead && lizardTail.IsUsedUp,
+			"the natural Lizard Tail must remain a one-shot native death preventer");
+		Assert(TrainingRevivalController.Capture(runState).RevivalsUsed == 0,
+			"the hidden bailout must not run before a native ShouldDie preventer");
+
+		await CreatureCmd.Kill(player.Creature);
+		Assert(!player.Creature.IsDead, "hidden bailout must recover the next ordinary death");
+		Assert(lizardTail.IsUsedUp, "hidden bailout must not rearm the natural Lizard Tail");
+		Assert(TrainingRevivalController.Capture(runState).RevivalsUsed == 1,
+			"hidden bailout must run only after the one-shot native preventer is exhausted");
+	}
+
+	private static async Task ResetAndSnapshotLifecycleIsRunScopedAsync(FullRunTrainingEnvService service)
+	{
+		await ResetAsync(service, "CLEAN_REVIVAL_SNAPSHOT", budget: 2);
+		RunState originalRun = CurrentRun();
+		Player originalPlayer = LocalPlayer(originalRun);
+		await CreatureCmd.Kill(originalPlayer.Creature);
+		Assert(TrainingRevivalController.Capture(originalRun).RevivalsUsed == 1,
+			"snapshot test setup must consume one bailout");
+		await CreatureCmd.Heal(originalPlayer.Creature, originalPlayer.Creature.MaxHp, playAnim: false);
+
+		string stateId = service.SaveState();
+		await CreatureCmd.Kill(originalPlayer.Creature);
+		Assert(TrainingRevivalController.Capture(originalRun).RevivalsUsed == 2,
+			"live run must advance independently after snapshot capture");
+
+		await service.LoadState(stateId);
+		RunState restoredRun = CurrentRun();
+		Assert(!ReferenceEquals(originalRun, restoredRun), "full snapshot restore must create a distinct RunState");
+		TrainingRevivalSnapshot restored = TrainingRevivalController.Capture(restoredRun);
+		Assert(restored.RevivalBudget == 2 && restored.RevivalsUsed == 1,
+			"full snapshot restore must recover the captured hidden bailout budget and counter");
+
+		await ResetAsync(service, "CLEAN_REVIVAL_RESET", budget: 2);
+		RunState resetRun = CurrentRun();
+		Assert(!ReferenceEquals(restoredRun, resetRun), "episode reset must create a distinct RunState");
+		TrainingRevivalSnapshot reset = TrainingRevivalController.Capture(resetRun);
+		Assert(reset.RevivalBudget == 2 && reset.RevivalsUsed == 0 && reset.PlayerHpLost == 0,
+			"episode reset must start isolated hidden bailout counters");
+	}
+
+	private static async Task<FullRunSimulationStateSnapshot> ResetAsync(
+		FullRunTrainingEnvService service,
+		string seed,
+		int budget,
+		List<SimulationBuildRelicSpec>? additionalRelics = null)
+	{
+		return await service.ResetAsync(new FullRunSimulationResetRequest
+		{
+			CharacterId = CharacterId,
+			Seed = seed,
+			Build = new SimulationBuildSpec
+			{
+				TrainingRevivalBudget = budget,
+				AdditionalRelics = additionalRelics
+			}
+		});
+	}
+
+	private static RunState CurrentRun()
+	{
+		return RunManager.Instance.DebugOnlyGetState()
+			?? throw new InvalidOperationException("Training revival self-test has no active RunState.");
+	}
+
+	private static Player LocalPlayer(RunState runState)
+	{
+		return runState.Players.Single();
+	}
+
+	private static void AttachMinimalCombat(RunState runState, Player player)
+	{
+		CombatState combatState = new(
+			runState: runState,
+			modifiers: runState.Modifiers,
+			multiplayerScalingModel: runState.MultiplayerScalingModel);
+		combatState.AddPlayer(player);
+	}
+
+	private static void AssertNoInjectedRevivalEntity(
+		RunState runState,
+		FullRunSimulationStateSnapshot state)
+	{
+		Player player = LocalPlayer(runState);
+		Assert(player.Relics.All(static relic => relic is not LizardTail),
+			"enabling hidden revival must not inject Lizard Tail into the player's relic inventory");
+		FullRunApiState apiState = FullRunApiStateBuilder.Build(runState, state);
+		string json = JsonSerializer.Serialize(apiState);
+		Assert(!json.Contains("LIZARD_TAIL", StringComparison.OrdinalIgnoreCase),
+			"enabling hidden revival must not expose an injected Lizard Tail in the API observation");
+	}
+
+	private static void Assert(bool condition, string message)
+	{
+		if (!condition)
+		{
+			throw new InvalidOperationException($"Training revival self-test failed: {message}");
+		}
+	}
+}
