diff --git a/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunPlayerResourceLifecycle.cs b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunPlayerResourceLifecycle.cs
new file mode 100644
index 0000000..2c108c2
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunPlayerResourceLifecycle.cs
@@ -0,0 +1,75 @@
+using System;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+/// <summary>
+/// Defines when the API may evaluate player resources whose getters execute
+/// combat hooks. PlayerCombatState can outlive Creature.CombatState briefly
+/// while the simulator advances from combat to rewards, map, or another room.
+/// </summary>
+public static class FullRunPlayerResourceLifecycle
+{
+	public static bool ShouldProjectCombatResources(
+		string? stateType,
+		bool hasPlayerCombatState,
+		bool hasCreatureCombatState)
+	{
+		bool isCombatSurface = stateType is "monster" or "elite" or "boss" or "hand_select";
+		return isCombatSurface && hasPlayerCombatState && hasCreatureCombatState;
+	}
+
+	/// <summary>
+	/// Regression for the map/rest transition that previously evaluated retained
+	/// Lightning/Frost orb values after Creature.CombatState was torn down.
+	/// </summary>
+	public static void RunSelfTests()
+	{
+		AssertProjection("monster", hasPlayerCombatState: true, hasCreatureCombatState: true, expected: true);
+		AssertProjection("elite", hasPlayerCombatState: true, hasCreatureCombatState: true, expected: true);
+		AssertProjection("boss", hasPlayerCombatState: true, hasCreatureCombatState: true, expected: true);
+		AssertProjection("hand_select", hasPlayerCombatState: true, hasCreatureCombatState: true, expected: true);
+
+		// Exact failure shape: the player wrapper is stale while the creature's
+		// authoritative combat lifecycle has already ended.
+		AssertProjection("map", hasPlayerCombatState: true, hasCreatureCombatState: false, expected: false);
+		AssertProjection("rest_site", hasPlayerCombatState: true, hasCreatureCombatState: false, expected: false);
+		AssertProjection("combat_rewards", hasPlayerCombatState: true, hasCreatureCombatState: false, expected: false);
+		AssertProjection("combat_post_end_pending", hasPlayerCombatState: true, hasCreatureCombatState: false, expected: false);
+
+		// A combat-looking surface is still not allowed to dereference orb values
+		// while either half of the lifecycle is absent.
+		AssertProjection("monster", hasPlayerCombatState: true, hasCreatureCombatState: false, expected: false);
+		AssertProjection("monster", hasPlayerCombatState: false, hasCreatureCombatState: true, expected: false);
+		AssertProjection("monster", hasPlayerCombatState: false, hasCreatureCombatState: false, expected: false);
+
+		string[] nonCombatSurfaces =
+		{
+			"menu", "run_bootstrap", "map", "event", "rest_site", "shop", "treasure",
+			"combat_rewards", "combat_post_end_pending", "card_reward", "card_select",
+			"relic_select", "game_over", "future_unknown_state"
+		};
+		foreach (string stateType in nonCombatSurfaces)
+		{
+			AssertProjection(stateType, hasPlayerCombatState: true, hasCreatureCombatState: true, expected: false);
+		}
+	}
+
+	private static void AssertProjection(
+		string stateType,
+		bool hasPlayerCombatState,
+		bool hasCreatureCombatState,
+		bool expected)
+	{
+		bool actual = ShouldProjectCombatResources(
+			stateType,
+			hasPlayerCombatState,
+			hasCreatureCombatState);
+		if (actual != expected)
+		{
+			throw new InvalidOperationException(
+				$"Player-resource lifecycle self-test failed: state_type={stateType}, " +
+				$"player_combat={hasPlayerCombatState}, creature_combat={hasCreatureCombatState}, " +
+				$"expected={expected}, actual={actual}.");
+		}
+	}
+}
