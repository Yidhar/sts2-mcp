+	private static void RunPlayerResourceProjectionLifecycleRuntimeSelfTests(
+		RunState runState,
+		Player player)
+	{
+		if (player.PlayerCombatState == null)
+		{
+			player.ResetCombatState();
+		}
+
+		var potionResult = player.AddPotionInternal(
+			ModelDb.Potion<AttackPotion>().ToMutable(),
+			silent: true);
+		if (!potionResult.success)
+		{
+			throw new InvalidOperationException(
+				"Player-resource lifecycle runtime self-test could not add its combat-only potion.");
+		}
+
+		AssertOrbProjectionLifecycle(runState, player, ModelDb.Orb<FrostOrb>().ToMutable());
+		AssertOrbProjectionLifecycle(runState, player, ModelDb.Orb<LightningOrb>().ToMutable());
+	}
+
+	private static void AssertOrbProjectionLifecycle(
+		RunState runState,
+		Player player,
+		OrbModel orb)
+	{
+		var playerCombatState = player.PlayerCombatState
+			?? throw new InvalidOperationException(
+				"Player-resource lifecycle runtime self-test requires PlayerCombatState.");
+		playerCombatState.OrbQueue.Clear();
+		playerCombatState.OrbQueue.AddCapacity(1);
+		orb.Owner = player;
+		playerCombatState.OrbQueue.Insert(0, orb);
+
+		if (player.Creature.CombatState != null)
+		{
+			player.Creature.CombatState.RemoveCreature(player.Creature);
+		}
+
+		foreach (string stateType in new[] { "map", "rest_site" })
+		{
+			if (stateType == "rest_site")
+			{
+				RunManager.Instance.RestSiteSynchronizer.BeginRestSite();
+			}
+
+			var snapshot = new FullRunSimulationStateSnapshot
+			{
+				IsRunActive = true,
+				IsPureSimulator = true,
+				StateType = stateType,
+				RoomType = stateType,
+				CachedBridgeSnapshots = new FullRunChoiceBridgeSnapshotCache()
+			};
+			FullRunApiState apiState = FullRunApiStateBuilder.Build(
+				runState,
+				snapshot,
+				FullRunSimulationChoiceBridge.Instance,
+				forceMapView: false);
+			FullRunApiPlayerState projected = stateType switch
+			{
+				"map" => apiState.map?.player
+					?? throw new InvalidOperationException("Map player projection was absent."),
+				"rest_site" => apiState.rest_site?.player
+					?? throw new InvalidOperationException("Rest-site player projection was absent."),
+				_ => throw new InvalidOperationException($"Unexpected lifecycle surface '{stateType}'.")
+			};
+			AssertNonCombatPlayerProjection(player, projected, stateType, orb.Id.Entry);
+		}
+
+		var activeCombatState = new CombatState(runState: runState);
+		activeCombatState.AddPlayer(player);
+		try
+		{
+			foreach (string stateType in new[] { "monster", "elite", "boss", "hand_select" })
+			{
+				FullRunApiPlayerState projected =
+					FullRunApiStateBuilder.BuildPlayerStateForLifecycle(player, stateType);
+				if (projected.orbs is not { Count: 1 }
+					|| projected.orbs[0].id != orb.Id.Entry
+					|| projected.orb_slots != 1
+					|| projected.orb_empty_slots != 0)
+				{
+					throw new InvalidOperationException(
+						$"Active-combat orb projection failed for state_type={stateType}, orb={orb.Id.Entry}.");
+				}
+				if (projected.orbs[0].passive_val != (int)orb.PassiveVal
+					|| projected.orbs[0].evoke_val != (int)orb.EvokeVal)
+				{
+					throw new InvalidOperationException(
+						$"Active-combat orb values drifted for state_type={stateType}, orb={orb.Id.Entry}.");
+				}
+			}
+		}
+		finally
+		{
+			activeCombatState.RemoveCreature(player.Creature);
+		}
+	}
+
+	private static void AssertNonCombatPlayerProjection(
+		Player player,
+		FullRunApiPlayerState projected,
+		string stateType,
+		string orbId)
+	{
+		if (projected.energy != 0
+			|| projected.max_energy != player.MaxEnergy
+			|| projected.draw_pile_count != 0
+			|| projected.discard_pile_count != 0
+			|| projected.exhaust_pile_count != 0
+			|| projected.stars != null
+			|| projected.orbs != null
+			|| projected.orb_slots != null
+			|| projected.orb_empty_slots != null
+			|| projected.draw_pile != null
+			|| projected.discard_pile != null
+			|| projected.exhaust_pile != null)
+		{
+			throw new InvalidOperationException(
+				$"Non-combat player projection leaked combat resources for state_type={stateType}, orb={orbId}.");
+		}
+		if (projected.hp != player.Creature.CurrentHp
+			|| projected.max_hp != player.Creature.MaxHp
+			|| projected.deck.Count != player.Deck.Cards.Count)
+		{
+			throw new InvalidOperationException(
+				$"Non-combat player projection lost persistent fields for state_type={stateType}, orb={orbId}.");
+		}
+		if (projected.potions.Count == 0
+			|| projected.potions.Any(static potion => potion.can_use_in_combat))
+		{
+			throw new InvalidOperationException(
+				$"Non-combat potion projection was not lifecycle-gated for state_type={stateType}, orb={orbId}.");
+		}
+	}
+
 	private void ThrowIfPostCombatContinuationFailed()
 	{
 		long generation = _postCombatGeneration.Capture();
