+	private static CombatTrainingSelectableCardSnapshot? BuildUpgradePreviewSnapshot(CardModel card, int choiceIndex)
+	{
+		if (!card.IsUpgradable)
+		{
+			return null;
+		}
+		try
+		{
+			// A detached fresh instance keeps live run state untouched while
+			// the canonical UpgradeInternal path (per-card OnUpgrade hooks +
+			// dynamic-var recalculation) produces the exact upgraded facts.
+			CardModel preview = ModelDb.GetById<CardModel>(card.Id).ToMutable();
+			int targetLevel = card.CurrentUpgradeLevel + 1;
+			while (preview.CurrentUpgradeLevel < targetLevel && preview.IsUpgradable)
+			{
+				preview.UpgradeInternal();
+				preview.FinalizeUpgradeInternal();
+			}
+			if (!preview.IsUpgraded)
+			{
+				return null;
+			}
+			return BuildSelectableCardSnapshotCore(preview, choiceIndex);
+		}
+		catch (Exception)
+		{
+			// The preview is optional enrichment; a card whose detached
+			// reconstruction fails simply ships without one.
+			return null;
+		}
+	}
+
