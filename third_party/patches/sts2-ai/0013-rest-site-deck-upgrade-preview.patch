+	private static FullRunApiCardOption? TryBuildDeckUpgradePreview(CardModel card)
+	{
+		if (!card.IsUpgradable)
+		{
+			return null;
+		}
+		try
+		{
+			CardModel preview = card.IsMutable
+				? (CardModel)card.ClonePreservingMutability()
+				: card.ToMutable();
+			int targetLevel = card.CurrentUpgradeLevel + 1;
+			while (preview.CurrentUpgradeLevel < targetLevel && preview.IsUpgradable)
+			{
+				preview.UpgradeInternal();
+				preview.FinalizeUpgradeInternal();
+			}
+			if (preview.CurrentUpgradeLevel != targetLevel)
+			{
+				return null;
+			}
+			FullRunApiCardOption option = ToApiCardOption(preview, index: 0);
+			option.source_pile = card.Pile?.Type.ToString() ?? PileType.Deck.ToString();
+			return option;
+		}
+		catch
+		{
+			return null;
+		}
+	}
