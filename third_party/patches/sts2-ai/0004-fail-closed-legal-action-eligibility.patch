index 0000000000000000000000000000000000000000..ebc037ad18a19fcba4858a53140404295a089822
--- /dev/null
+++ b/STS2AI/ENV/Sim/HeadlessSim/Simulation/FullRunLegalActionEligibility.cs
@@ -0,0 +1,89 @@
+using System;
+using System.Collections.Generic;
+
+namespace MegaCrit.Sts2.Core.Simulation;
+
+internal static class FullRunLegalActionEligibility
+{
+	internal static bool IsShopPurchaseSupported(
+		bool isStocked,
+		bool enoughGold,
+		bool isPotionEntry,
+		bool hasOpenPotionSlots,
+		bool canProcurePotion)
+	{
+		return isStocked
+			&& enoughGold
+			&& (!isPotionEntry || (hasOpenPotionSlots && canProcurePotion));
+	}
+
+	internal static IEnumerable<uint?> EnumerateCardPlayTargets(
+		bool requiresTarget,
+		IReadOnlyList<uint> validTargetIds)
+	{
+		ArgumentNullException.ThrowIfNull(validTargetIds);
+		if (!requiresTarget)
+		{
+			yield return null;
+			yield break;
+		}
+		foreach (uint targetId in validTargetIds)
+		{
+			yield return targetId;
+		}
+	}
+
+	internal static void RunSelfTests()
+	{
+		Assert(
+			!IsShopPurchaseSupported(
+				isStocked: true,
+				enoughGold: true,
+				isPotionEntry: true,
+				hasOpenPotionSlots: false,
+				canProcurePotion: true),
+			"full potion slots must suppress an otherwise affordable potion purchase");
+		Assert(
+			!IsShopPurchaseSupported(
+				isStocked: true,
+				enoughGold: true,
+				isPotionEntry: true,
+				hasOpenPotionSlots: true,
+				canProcurePotion: false),
+			"Sozu must suppress an otherwise affordable potion purchase even with an open slot");
+		Assert(
+			IsShopPurchaseSupported(
+				isStocked: true,
+				enoughGold: true,
+				isPotionEntry: true,
+				hasOpenPotionSlots: true,
+				canProcurePotion: true),
+			"an ordinary open-slot player must preserve an otherwise affordable potion purchase");
+
+		List<uint?> noTargets = new List<uint?>(
+			EnumerateCardPlayTargets(requiresTarget: true, Array.Empty<uint>()));
+		Assert(noTargets.Count == 0, "target-required cards with zero valid targets must emit no action");
+
+		List<uint?> multipleTargets = new List<uint?>(
+			EnumerateCardPlayTargets(requiresTarget: true, new uint[] { 17u, 42u }));
+		Assert(
+			multipleTargets.Count == 2
+				&& multipleTargets[0] == 17u
+				&& multipleTargets[1] == 42u,
+			"target-required cards must emit one action per valid target id in order");
+
+		List<uint?> targetless = new List<uint?>(
+			EnumerateCardPlayTargets(requiresTarget: false, Array.Empty<uint>()));
+		Assert(
+			targetless.Count == 1 && targetless[0] == null,
+			"targetless cards must emit exactly one action with no target id");
+	}
+
+	private static void Assert(bool condition, string detail)
+	{
+		if (!condition)
+		{
+			throw new InvalidOperationException($"Legal-action eligibility self-test failed: {detail}.");
+		}
+	}
+}
