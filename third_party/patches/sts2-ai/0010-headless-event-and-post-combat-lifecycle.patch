+	/// <summary>
+	/// Mirrors CombatManager.IsEnding: only a living primary enemy blocks the
+	/// authoritative post-combat continuation.  Secondary summons may remain
+	/// alive after their owner dies and must not strand the room lifecycle.
+	/// </summary>
+	public static bool BlocksPostCombatContinuation(bool isAlive, bool isPrimaryEnemy)
+	{
+		return isAlive && isPrimaryEnemy;
+	}
+
+	/// <summary>
+	/// A changed post-combat pending snapshot is still transitional.  Treat it
+	/// as settled only after it reaches an actionable combat decision surface
+	/// or a non-combat state other than the explicit pending sentinel.
+	/// </summary>
+	public static bool IsCombatFollowupSettled(
+		bool stateChanged,
+		bool isPostCombatPending,
+		bool isCombatState,
+		bool isActionableCombatState)
+	{
+		return stateChanged
+			&& !isPostCombatPending
+			&& (!isCombatState || isActionableCombatState);
+	}
