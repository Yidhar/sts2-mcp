      "decision_domain",
      "logic_hash",
      "run",
      "player",
      "combat",
      "decision"
    ]
  },
  "action_encoding": {
    "default_encoding": "legal_action_idx",
    "supported": [
      "legal_action_idx",
      "action_handle"
