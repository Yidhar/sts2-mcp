# Training data, runs, checkpoints, logs, and process state are intentionally
# not ignored. They must be written below the external STS2_ARTIFACT_ROOT; any
# repository-local residue should be visible to the hygiene gate and removed.

# Generated release packages belong in CI release artifacts, not Git
/release-assets/

# Pinned third-party source is restored by tools/third_party scripts.
/third_party/sts2-ai/

# Canonical architecture docs, schemas, component READMEs, and shell scripts
